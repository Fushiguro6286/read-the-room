QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# LLM: set GEMINI_API_KEY (free tier) to use Gemini; otherwise ANTHROPIC_API_KEY is used
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
APP_URL=http://localhost:3000
QLOO_MAX_CALLS_PER_RUN=20
MAX_REFERENCES_PER_TEXT=8
MAX_ROUNDS=3
LIVE_RUNS_PER_IP_PER_HOUR=6
LIVE_RUNS_PER_IP_PER_DAY=20
LIVE_RUNS_PER_DAY_GLOBAL=300
